# --- LLM ---
# Local generation via Ollama. No API key, no cost, no network egress.
# Install: https://ollama.com  Then: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# --- Models (downloaded from HuggingFace on first run) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval pipeline ---
# Candidates pulled from EACH retriever (vector + BM25) before fusion.
CANDIDATE_POOL=20
# Candidates kept after fusion and passed to the cross-encoder re-ranker.
RERANK_POOL=10
# Chunks finally sent to the LLM as context.
TOP_K=4
# Hybrid weighting: score = alpha * vector + (1 - alpha) * bm25.
# 1.0 = pure semantic, 0.0 = pure keyword. Overridable per-request from the UI.
HYBRID_ALPHA=0.6
# Abstention gate. The system refuses only when BOTH signals are weak: the
# cross-encoder score AND the dense cosine similarity. Either alone gives an
# unusable false-refusal rate -- see backend/eval/eval_results.md.
CONFIDENCE_THRESHOLD=0.15
VECTOR_CONFIDENCE_THRESHOLD=0.30

# --- Storage (paths relative to backend/) ---
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=documents
# Rejected immediately, before chunking/embedding. Verified live: with no cap,
# a 34MB upload took 58 minutes to embed and then still failed at the final
# write step (ChromaDB rejects a batch that large).
MAX_UPLOAD_MB=20

# --- CORS ---
ALLOWED_ORIGINS=*
